{
  "name": "gatsby-starter-tailwind",
  "description": "Gatsby starter styled with Tailwind",
  "version": "4.0.0",
  "author": "Taylor Bryant <taylor@bryant.io>",
  "dependencies": {
    "gatsby": "5.16.1",
    "gatsby-plugin-manifest": "5.16.0",
    "gatsby-plugin-offline": "6.16.0",
    "gatsby-plugin-postcss": "6.16.0",
    "gatsby-plugin-purgecss": "6.2.1",
    "gatsby-plugin-react-helmet": "6.16.0",
    "gatsby-plugin-sharp": "5.16.0",
    "moment": "^2.30.1",
    "pdfmake": "^0.3.8",
    "pdfjs-dist": "^5.7.284",
    "prop-types": "15.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-helmet": "6.1.0"
  },
  "keywords": [
    "gatsby",
    "tailwind",
    "tailwindcss",
    "purgecss"
  ],
  "license": "MIT",
  "scripts": {
    "analyze:lint": "eslint --ext .jsx --ext .js .",
    "analyze:prettier": "prettier --list-different \"**/*.{css,js,jsx,json,md}\"",
    "analyze": "npm run analyze:lint && npm run analyze:prettier",
    "fix:lint": "eslint --ext .jsx --ext .js . --fix",
    "fix:prettier": "prettier --write \"**/*.{css,js,jsx,json,md}\"",
    "fix": "npm run fix:lint && npm run fix:prettier",
    "build": "gatsby build",
    "develop": "gatsby develop",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1",
    "load": "gatsby build && gatsby serve",
    "load-dev": "gatsby develop && gatsby serve"
  },
  "devDependencies": {
    "@tailwindcss/custom-forms": "0.2.1",
    "autoprefixer": "10.5.0",
    "babel-eslint": "10.1.0",
    "cssnano": "8.0.1",
    "eslint": "10.3.0",
    "eslint-loader": "4.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "gatsby-plugin-eslint": "4.0.4",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taylorbryant/gatsby-starter-tailwind"
  },
  "bugs": {
    "url": "https://github.com/taylorbryant/gatsby-starter-tailwind/issues"
  }
}
